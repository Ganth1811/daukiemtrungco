---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);
---

<BaseLayout title="Trang chủ">
  <section class="hero">
    <p class="eyebrow">HEMAVN</p>
    <h1>Võ thuật vũ trang lịch sử <em>được chắp bút</em> bằng tiếng Việt.</h1>
    <p class="lede">
      Một trang tổng hợp các bài viết và tài liệu về Historical Fencing/HEMA,
      được đúc kết lại qua nhiều kiến thức, kinh nghiệm tập luyện của các kiếm
      thủ Việt nhằm lưu giữ, chia sẻ và lan tỏa đến mọi người tập.
    </p>
  </section>

  <section>
    <h2>Bài viết mới nhất</h2>
    <div class="grid">
      {
        latest.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            weapon={post.data.weapon}
            level={post.data.level}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: 4.5rem 0 3.5rem;
    overflow: hidden;
    isolation: isolate;
    min-height: clamp(320px, 42vw, 460px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* Banner nền: ảnh SVG 2 thanh trường kiếm bắt chéo (public/images/hero-banner.svg),
     đặt lệch phải + 1 lớp "scrim" phủ từ trái sang để chữ luôn dễ đọc dù ảnh nền
     có thay đổi (kể cả khi sau này bạn thay bằng ảnh chụp thật). */
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(
        to right,
        var(--color-paper) 0%,
        color-mix(in srgb, var(--color-paper) 65%, transparent) 42%,
        transparent 68%
      ),
      url("/images/hero-banner.svg");
    background-size: cover, cover;
    background-position:
      center,
      right center;
    background-repeat: no-repeat, no-repeat;
    z-index: -1;
  }
  .hero h1 {
    max-width: 30ch;
    text-wrap: balance;
    position: relative;
  }
  .lede {
    max-width: 52ch;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    position: relative;
  }

  /* Animation load-in: xuất hiện ngay khi trang tải, không cần JS vì nằm
     ngay đầu trang (above the fold) — set độ trễ so le cho 3 dòng. */
  .hero .eyebrow,
  .hero h1,
  .hero .lede {
    animation: fade-up 0.7s ease both;
  }
  .hero h1 {
    animation-delay: 0.08s;
  }
  .hero .lede {
    animation-delay: 0.16s;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }
</style>

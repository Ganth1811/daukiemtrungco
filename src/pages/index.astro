---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);
---

<BaseLayout title="Trang chủ">
  <Fragment slot="hero">
    <p class="eyebrow">HEMAVN</p>
    <h1>Võ thuật vũ trang lịch sử <em>được chắp bút</em> bằng tiếng Việt.</h1>
    <p class="lede">
      Một trang tổng hợp các bài viết và tài liệu về Historical Fencing/HEMA,
      được đúc kết lại qua nhiều kiến thức, kinh nghiệm tập luyện của các kiếm
      thủ Việt nhằm lưu giữ, chia sẻ và lan tỏa đến mọi huynh hữu tập luyện.
    </p>
  </Fragment>

  <section class="latest-posts">
    <h2>Bài viết mới nhất</h2>
    <div class="grid">
      {
        latest.map((post) => (
          <PostCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            weapon={post.data.weapon}
            level={post.data.level}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  /* Nội dung hero trang chủ được author Ở ĐÂY (truyền qua slot "hero" vào
     BaseLayout), nên style/animation riêng của nó cũng phải nằm ở đây —
     không phải trong HeroBanner.astro. Astro scope CSS theo nơi phần tử
     được VIẾT ra, không phải nơi nó được RENDER ra. */
  :global(.hero) h1 {
    max-width: 30ch;
    text-wrap: balance;
    position: relative;
  }
  .lede {
    max-width: 52ch;
    color: var(--color-ink-soft);
    font-size: 1.05rem;
    position: relative;
  }

  .eyebrow,
  h1,
  .lede {
    animation: fade-up 0.7s ease both;
  }
  h1 {
    animation-delay: 0.08s;
  }
  .lede {
    animation-delay: 0.16s;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }

  .latest-posts {
    margin-top: 4.5rem;
  }
</style>

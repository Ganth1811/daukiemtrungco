---
// Mô-típ chữ ký của site: hai đường chéo giao nhau bên trong khung vuông,
// gợi lại sơ đồ "Vier Blössen" (bốn ô mục tiêu) và các đường tấn công
// (lines of attack) hay xuất hiện trong fechtbuch (sách kiếm thuật cổ).
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className = '' } = Astro.props;
---

<svg
  class={`cross-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="1.5" y="1.5" width="21" height="21" rx="1" stroke="currentColor" stroke-width="1.2" />
  <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="1.2" />
  <line x1="21" y1="3" x2="3" y2="21" stroke="currentColor" stroke-width="1.2" />
  <circle cx="12" cy="12" r="1.6" fill="currentColor" />
</svg>

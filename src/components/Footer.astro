---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap bar">
    <p class="eyebrow">© {year} Thắng - Thổ Phỉ Mè Đen Historical Fencing</p>
    <p class="eyebrow">Viết về HEMA bằng tiếng Việt</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-steel-light);
    padding: 2rem 0;
    margin-top: 4rem;
  }
  .bar {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  p {
    margin: 0;
  }
</style>

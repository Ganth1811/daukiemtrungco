---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  weapon?: string;
  level?: string;
}
const { slug, title, description, pubDate, weapon, level } = Astro.props;

const formatted = pubDate.toLocaleDateString('vi-VN', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});

const weaponLabel: Record<string, string> = {
  'truong-kiem': 'Trường kiếm',
  'kiem-mot-tay': 'Kiếm một tay',
  'dao-gam': 'Dao găm',
  'vat': 'Vật',
  'khac': 'Khác',
};
const levelLabel: Record<string, string> = {
  'co-ban': 'Cơ bản',
  'trung-cap': 'Trung cấp',
  'nang-cao': 'Nâng cao',
  'ly-thuyet': 'Lý thuyết',
};
---

<a href={`/blog/${slug}`} class="card-link reveal">
  <article class="card">
    <p class="eyebrow meta">
      {formatted}
      {weapon && <span> · {weaponLabel[weapon] ?? weapon}</span>}
      {level && <span> · {levelLabel[level] ?? level}</span>}
    </p>
    <h3>{title}</h3>
    <p class="desc">{description}</p>
  </article>
</a>

<style>
  .card-link {
    text-decoration: none;
    color: inherit;
    display: flex;
    height: 100%;
  }
  .card {
    width: 100%;
    display: flex;
    flex-direction: column;
  }
  .meta {
    margin-bottom: 0.5rem;
    font-size: 0.72rem;
  }
  h3 {
    margin-bottom: 0.5rem;
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .desc {
    color: var(--color-ink-soft);
    margin-bottom: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

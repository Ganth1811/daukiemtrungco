---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import HeroBanner from "../components/HeroBanner.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  heroCompact?: boolean;
}
const {
  title,
  description = "Blog tiếng Việt về HEMA (Historical European Martial Arts) — kỹ thuật, lịch sử và tài liệu kiếm thuật cổ.",
  heroCompact = false,
} = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Đấu Kiếm Trung Cổ</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const theme = localStorage.getItem("theme") || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <Header />
    <HeroBanner compact={heroCompact}>
      <slot name="hero">
        <h1>{title}</h1>
      </slot>
    </HeroBanner>
    <main class="wrap">
      <slot />
    </main>
    <Footer />
    <ScrollReveal />
  </body>
</html>

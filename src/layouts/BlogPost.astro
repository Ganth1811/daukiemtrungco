---
import BaseLayout from './BaseLayout.astro';
import Divider from '../components/Divider.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  weapon?: string;
  source?: string;
  level?: string;
  tags?: string[];
}
const { title, description, pubDate, updatedDate, weapon, source, level, tags = [] } =
  Astro.props;

const formatted = pubDate.toLocaleDateString('vi-VN', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <article class="prose">
    <p class="eyebrow">{formatted}{updatedDate && ' · đã cập nhật'}</p>
    <h1>{title}</h1>

    <p class="meta-line">
      {weapon && <span class="tag">{weapon}</span>}
      {level && <span class="tag">{level}</span>}
      {source && <span class="tag">Nguồn: {source}</span>}
    </p>

    <Divider />

    <slot />

    {tags.length > 0 && (
      <>
        <Divider />
        <p class="eyebrow" style="margin-bottom:0.6rem;">Chủ đề liên quan</p>
        <p>
          {tags.map((t) => (
            <a class="tag" href={`/tags/${t}`}>#{t}</a>
          ))}
        </p>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .meta-line { margin-top: -0.4rem; }
</style>
